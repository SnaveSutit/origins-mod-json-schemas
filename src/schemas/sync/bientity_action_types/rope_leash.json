{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=bientity_actions/rope_leash",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"max_length": {
			"type": "number",
			"default": 10.0
		},
		"texture": {
			"$ref": "$ref(apoli:types/identifier)",
			"default": "sync:textures/rope/rope.png"
		},
		"mode": {
			"enum": ["toggle", "attach", "detach", "detach_all"],
			"default": "toggle"
		}
	}
}
