{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=entity_actions/disguise_as",
	"type": "object",
	"required": ["entity_type"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"entity_type": {
			"$ref": "$ref(apoli:types/autofill_helpers/entity_identifier)"
		},
		"nbt": {
			"$ref": "$ref(apoli:types/nbt)"
		},
		"overwrite": {
			"type": "boolean",
			"default": true
		},
		"before_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"after_action": {
			"$ref": "$ref(apoli:entity_action)"
		}
	}
}
