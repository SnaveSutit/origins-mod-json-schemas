{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=entity_actions/custom_projectile",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"entity_id": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"texture_location": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"count": {
			"type": "integer",
			"default": 1
		},
		"speed": {
			"type": "number",
			"default": 1.5
		},
		"divergence": {
			"type": "number",
			"default": 1.0
		},
		"sound": {
			"$ref": "$ref(apoli:types/autofill_helpers/sound_identifier)"
		},
		"tag": {
			"$ref": "$ref(apoli:types/nbt)"
		},
		"entity_action_before_firing": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"bientity_action_after_firing": {
			"$ref": "$ref(apoli:bientity_action)"
		},
		"block_action_on_hit": {
			"$ref": "$ref(apoli:block_action)"
		},
		"bientity_action_on_miss": {
			"$ref": "$ref(apoli:bientity_action)"
		},
		"bientity_action_on_hit": {
			"$ref": "$ref(apoli:bientity_action)"
		},
		"owner_target_bientity_action_on_hit": {
			"$ref": "$ref(apoli:bientity_action)"
		},
		"block_action_cancels_miss_action": {
			"type": "boolean",
			"default": false
		},
		"block_condition": {
			"$ref": "$ref(apoli:block_condition)"
		},
		"bientity_condition": {
			"$ref": "$ref(apoli:bientity_condition)"
		},
		"owner_bientity_condition": {
			"$ref": "$ref(apoli:bientity_condition)"
		},
		"tick_bientity_action": {
			"$ref": "$ref(apoli:bientity_action)"
		}
	}
}
