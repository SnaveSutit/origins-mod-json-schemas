{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=entity_actions/raycast",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"distance": {
			"type": "number"
		},
		"block": {
			"type": "boolean",
			"default": true
		},
		"entity": {
			"type": "boolean",
			"default": true
		},
		"shape_type": {
			"$ref": "$ref(apoli:types/shape_type)",
			"default": "visual"
		},
		"fluid_handling": {
			"$ref": "$ref(apoli:types/fluid_handling)",
			"default": "any"
		},
		"space": {
			"$ref": "$ref(apoli:types/space)",
			"default": "world"
		},
		"direction": {
			"$ref": "$ref(apoli:types/vector)"
		},
		"pierce": {
			"type": "boolean",
			"default": false
		},
		"particle": {
			"$ref": "$ref(apoli:types/particle_effect)"
		},
		"spacing": {
			"type": "number",
			"default": 0.5
		},
		"entity_distance": {
			"type": "number"
		},
		"block_distance": {
			"type": "number"
		},
		"bientity_condition": {
			"$ref": "$ref(apoli:bientity_condition)"
		},
		"block_condition": {
			"$ref": "$ref(apoli:block_condition)"
		},
		"bientity_action": {
			"$ref": "$ref(apoli:bientity_action)"
		},
		"block_action": {
			"$ref": "$ref(apoli:block_action)"
		},
		"before_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"hit_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"miss_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"command_at_hit": {
			"type": "string"
		},
		"command_hit_offset": {
			"type": "number"
		},
		"command_along_ray": {
			"type": "string"
		},
		"command_step": {
			"type": "number",
			"default": 1.0
		},
		"command_along_ray_only_on_hit": {
			"type": "boolean",
			"default": false
		}
	}
}
