{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=entity_conditions/velocity",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"x": {
			"type": "number"
		},
		"y": {
			"type": "number"
		},
		"z": {
			"type": "number"
		},
		"axes": {
			"type": "array",
			"items": {
				"enum": ["x", "y", "z"]
			}
		},
		"comparison": {
			"default": ">=",
			"$ref": "$ref(apoli:types/comparison)"
		},
		"compare_to": {
			"type": "number",
			"default": 0.0
		}
	}
}
