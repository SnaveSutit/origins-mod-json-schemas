{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=bientity_conditions/command",
	"type": "object",
	"required": ["command", "comparison", "compare_to"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"command": {
			"type": "string"
		},
		"actor_selector": {
			"type": "string",
			"default": "%a"
		},
		"target_selector": {
			"type": "string",
			"default": "%t"
		},
		"comparison": {
			"$ref": "$ref(apoli:types/comparison)"
		},
		"compare_to": {
			"type": "integer"
		}
	}
}
