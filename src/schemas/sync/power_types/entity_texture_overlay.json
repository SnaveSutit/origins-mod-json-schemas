{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=power_types/entity_texture_overlay",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"wide_texture_location": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"slim_texture_location": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"show_first_person": {
			"type": "boolean",
			"default": false
		},
		"render_as_overlay": {
			"type": "boolean",
			"default": false
		},
		"red": {
			"type": "number",
			"minimum": 0.0,
			"maximum": 1.0,
			"default": 1.0
		},
		"green": {
			"type": "number",
			"minimum": 0.0,
			"maximum": 1.0,
			"default": 1.0
		},
		"blue": {
			"type": "number",
			"minimum": 0.0,
			"maximum": 1.0,
			"default": 1.0
		},
		"alpha": {
			"type": "number",
			"minimum": 0.0,
			"maximum": 1.0,
			"default": 1.0
		},
		"hide_cape": {
			"type": "boolean",
			"default": false
		}
	}
}
