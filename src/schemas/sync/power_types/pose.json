{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=power_types/pose",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"entity_pose": {
			"enum": [
				"STANDING",
				"FALL_FLYING",
				"SLEEPING",
				"SWIMMING",
				"SPIN_ATTACK",
				"CROUCHING",
				"LONG_JUMPING",
				"DYING",
				"CROAKING",
				"USING_TONGUE",
				"SITTING",
				"ROARING",
				"SNIFFING",
				"EMERGING",
				"DIGGING"
			]
		},
		"arm_pose": {
			"enum": [
				"EMPTY",
				"ITEM",
				"BLOCK",
				"BOW_AND_ARROW",
				"THROW_SPEAR",
				"CROSSBOW_CHARGE",
				"CROSSBOW_HOLD",
				"SPYGLASS",
				"TOOT_HORN",
				"BRUSH"
			]
		},
		"priority": {
			"type": "integer",
			"default": 0
		}
	}
}
