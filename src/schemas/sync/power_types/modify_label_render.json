{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=power_types/modify_label_render",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"before_parse_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"after_parse_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"render_mode": {
			"enum": ["default", "hide_partially", "hide_completely"],
			"default": "default"
		},
		"text": {
			"$ref": "$ref(apoli:types/text_component)"
		},
		"tick_rate": {
			"type": "integer",
			"default": 20
		},
		"priority": {
			"type": "integer",
			"default": 0
		},
		"entity_condition": {
			"$ref": "$ref(apoli:entity_condition)"
		},
		"bientity_condition": {
			"$ref": "$ref(apoli:bientity_condition)"
		}
	}
}
