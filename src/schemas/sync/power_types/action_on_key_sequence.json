{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=power_types/action_on_key_sequence",
	"type": "object",
	"required": ["keys", "key_sequence"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"success_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"fail_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"cooldown": {
			"type": "integer",
			"default": 0
		},
		"hud_render": {
			"$ref": "$ref(apoli:types/hud_render)",
			"default": { "should_render": false }
		},
		"keys": {
			"type": "array",
			"items": {
				"$ref": "$ref(sync:types/functional_key)"
			}
		},
		"key_sequence": {
			"type": "array",
			"items": {
				"type": "string"
			}
		}
	}
}
