{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://0vergrown.github.io/Sync-Documentation-Website/?file=power_types/body_part_damage_modifier",
	"type": "object",
	"required": ["modifiers"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Sync](https://modrinth.com/mod/sync) to be installed! ⚠️\n\n"
		},
		"modifiers": {
			"type": "array",
			"items": {
				"$ref": "$ref(sync:types/body_part_modifier_entry)"
			}
		},
		"damage_condition": {
			"$ref": "$ref(apoli:damage_condition)"
		},
		"require_hit_data": {
			"type": "boolean",
			"default": false
		},
		"show_hit_location": {
			"type": "boolean",
			"default": false
		}
	}
}
