{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://github.com/Provismet/Provi-Origins/wiki/Particle-Beam",
	"type": "object",
	"required": ["particle", "step"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n"
		},
		"particle": {
			"$ref": "$ref(apoli:types/particle_effect)"
		},
		"step": {
			"type": "number"
		},
		"speed": {
			"type": "number",
			"default": 0.0
		},
		"count": {
			"type": "integer",
			"default": 1
		},
		"actor_offset_y": {
			"type": "number",
			"default": 0.0
		},
		"target_offset_y": {
			"type": "number",
			"default": 0.0
		}
	}
}
