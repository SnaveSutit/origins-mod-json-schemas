{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://github.com/Provismet/Provi-Origins/wiki/Fire-Projectile",
	"type": "object",
	"required": ["entity_type"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n"
		},
		"entity_type": {
			"$ref": "$ref(apoli:types/autofill_helpers/entity_identifier)"
		},
		"divergence": {
			"type": "number",
			"default": 1.0
		},
		"speed": {
			"type": "number",
			"default": 1.5
		},
		"count": {
			"type": "integer",
			"default": 1
		},
		"tag": {
			"$ref": "$ref(apoli:types/nbt)"
		},
		"projectile_action": {
			"$ref": "$ref(apoli:entity_action)"
		}
	}
}
