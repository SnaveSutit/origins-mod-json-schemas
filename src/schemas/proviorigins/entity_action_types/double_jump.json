{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://github.com/Provismet/Provi-Origins/wiki/Double-Jump",
	"type": "object",
	"required": ["velocity"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n"
		},
		"velocity": {
			"type": "number"
		},
		"client": {
			"type": "boolean",
			"default": true
		},
		"server": {
			"type": "boolean",
			"default": true
		},
		"reset_fall_height": {
			"type": "boolean",
			"default": true
		}
	}
}
