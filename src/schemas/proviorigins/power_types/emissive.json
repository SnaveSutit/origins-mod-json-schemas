{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://github.com/Provismet/Provi-Origins/wiki/Emissive",
	"type": "object",
	"required": ["light"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Provi's Origins](https://github.com/Provismet/Provi-Origins/wiki) to be installed! ⚠️\n\n"
		},
		"light": {
			"type": "integer",
			"minimum": 0,
			"maximum": 15
		},
		"dynamic_light": {
			"type": "integer",
			"minimum": 0,
			"maximum": 15,
			"default": 0
		}
	}
}
