{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/entity_action_types/replace_inventory/",
	"type": "object",
	"required": ["stack"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"inventory_type": {
			"$ref": "$ref(apoli:types/inventory_type)",
			"default": "inventory"
		},
		"entity_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"item_action": {
			"$ref": "$ref(apoli:item_action)"
		},
		"item_condition": {
			"$ref": "$ref(apoli:item_condition)"
		},
		"slot": {
			"$ref": "$ref(apoli:types/item_slot)"
		},
		"slots": {
			"type": "array",
			"items": {
				"$ref": "$ref(apoli:types/item_slot)"
			}
		},
		"power": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"stack": {
			"$ref": "$ref(apoli:types/item_stack)"
		},
		"merge_nbt": {
			"type": "boolean",
			"default": false
		}
	}
}
