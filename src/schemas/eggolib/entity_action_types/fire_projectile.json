{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/entity_action_types/fire_projectile/",
	"type": "object",
	"required": ["entity_type"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"entity_type": {
			"$ref": "$ref(apoli:types/autofill_helpers/entity_identifier)"
		},
		"divergence": {
			"type": "number",
			"default": 1.0
		},
		"speed": {
			"type": "number",
			"default": 1.0
		},
		"count": {
			"type": "integer",
			"default": 1
		},
		"tag": {
			"$ref": "$ref(apoli:types/nbt)"
		},
		"entity_action": {
			"$ref": "$ref(apoli:entity_action)"
		}
	}
}
