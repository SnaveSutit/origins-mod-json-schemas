{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/entity_action_types/play_sound/",
	"type": "object",
	"required": ["sound"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"sound": {
			"$ref": "$ref(apoli:types/autofill_helpers/sound_identifier)"
		},
		"category": {
			"$ref": "$ref(eggolib:types/sound_category)"
		},
		"volume": {
			"type": "number",
			"default": 1.0
		},
		"pitch": {
			"type": "number",
			"default": 1.0
		}
	}
}
