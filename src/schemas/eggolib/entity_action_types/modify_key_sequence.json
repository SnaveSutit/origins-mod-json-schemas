{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/entity_action_types/modify_key_sequence/",
	"type": "object",
	"required": ["power"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"power": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"operation": {
			"enum": ["append", "insert", "prepend", "remove", "set"],
			"default": "append"
		},
		"keys": {
			"type": "array",
			"items": {
				"$ref": "$ref(eggolib:types/key)"
			}
		},
		"index": {
			"type": "integer",
			"default": -1
		}
	}
}
