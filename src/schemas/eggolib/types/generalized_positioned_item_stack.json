{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/data_types/generalized_positioned_item_stack/",
	"type": "object",
	"required": ["item"],
	"properties": {
		"item": {
			"$ref": "$ref(apoli:types/autofill_helpers/item_identifier)"
		},
		"amount": {
			"type": "integer",
			"default": 1
		},
		"tag": {
			"type": "string"
		},
		"slot": {
			"type": "string"
		}
	}
}
