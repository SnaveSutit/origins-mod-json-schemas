{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/power_types/tooltip/",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"item_condition": {
			"$ref": "$ref(apoli:item_condition)"
		},
		"text": {
			"$ref": "$ref(apoli:types/text_component)"
		},
		"texts": {
			"type": "array",
			"items": {
				"$ref": "$ref(apoli:types/text_component)"
			}
		},
		"tick_rate": {
			"$ref": "$ref(eggolib:types/positive_integer)",
			"default": 20
		},
		"order": {
			"type": "integer",
			"default": 0
		}
	}
}
