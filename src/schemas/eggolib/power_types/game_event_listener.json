{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/power_types/game_event_listener/",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"block_action": {
			"$ref": "$ref(apoli:block_action)"
		},
		"bientity_action": {
			"$ref": "$ref(apoli:bientity_action)"
		},
		"block_condition": {
			"$ref": "$ref(apoli:block_condition)"
		},
		"bientity_condition": {
			"$ref": "$ref(apoli:bientity_condition)"
		},
		"cooldown": {
			"$ref": "$ref(eggolib:types/positive_integer)",
			"default": 1
		},
		"hud_render": {
			"$ref": "$ref(apoli:types/hud_render)"
		},
		"range": {
			"$ref": "$ref(eggolib:types/positive_integer)",
			"default": 16
		},
		"event": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"events": {
			"type": "array",
			"items": {
				"$ref": "$ref(apoli:types/identifier)"
			}
		},
		"tag": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"show_particle": {
			"type": "boolean",
			"default": true
		}
	}
}
