{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/power_types/modify_label_render/",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"before_parse_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"after_parse_action": {
			"$ref": "$ref(apoli:entity_action)"
		},
		"render_mode": {
			"$ref": "$ref(eggolib:types/render_mode)",
			"default": "default"
		},
		"text": {
			"$ref": "$ref(apoli:types/text_component)"
		},
		"tick_rate": {
			"$ref": "$ref(eggolib:types/positive_integer)",
			"default": 20
		},
		"priority": {
			"type": "integer",
			"default": 0
		}
	}
}
