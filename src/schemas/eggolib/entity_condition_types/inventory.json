{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/entity_condition_types/inventory/",
	"type": "object",
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"inventory_type": {
			"$ref": "$ref(apoli:types/inventory_type)",
			"default": "inventory"
		},
		"item_condition": {
			"$ref": "$ref(apoli:item_condition)"
		},
		"comparison": {
			"default": ">",
			"$ref": "$ref(apoli:types/comparison)"
		},
		"compare_to": {
			"type": "integer",
			"default": 0
		},
		"slot": {
			"$ref": "$ref(apoli:types/item_slot)"
		},
		"slots": {
			"type": "array",
			"items": {
				"$ref": "$ref(apoli:types/item_slot)"
			}
		},
		"power": {
			"$ref": "$ref(apoli:types/identifier)"
		}
	}
}
