{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/entity_condition_types/in_block/",
	"type": "object",
	"required": ["block_condition"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"block_condition": {
			"$ref": "$ref(apoli:block_condition)"
		},
		"offset": {
			"$ref": "$ref(eggolib:types/entity_offset)",
			"default": "feet"
		}
	}
}
