{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$docsUrl": "https://eggolib.github.io/latest/types/item_action_types/modify/",
	"type": "object",
	"required": ["modifier"],
	"properties": {
		"type": {
			"description": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n",
			"markdownDescription": "### ⚠️ Requires [Eggolib](https://eggolib.github.io/latest/) to be installed! ⚠️\n\n"
		},
		"modifier": {
			"$ref": "$ref(apoli:types/identifier)"
		},
		"position": {
			"$ref": "$ref(apoli:types/vector)",
			"default": { "x": 0, "y": 0, "z": 0 }
		},
		"dimension": {
			"$ref": "$ref(apoli:types/autofill_helpers/dimension_identifier)",
			"default": "minecraft:overworld"
		}
	}
}
